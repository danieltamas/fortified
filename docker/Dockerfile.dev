# Dev/test/build image for fortified. No Go toolchain is installed on the
# operator's host machine (arm64 Mac, only Intel Homebrew available) — every
# `just` recipe runs through this image instead of a local install.
#
# Includes borgbackup + docker CLI so Phase 4's local integration tests
# (real borg against a tmp repo, real Postgres/MariaDB containers) run the
# same way the shipped binary itself works — no testcontainers library.
# The docker CLI here talks to the *host* daemon via the mounted socket
# (docker-outside-of-docker), so containers it starts are siblings, not
# nested — never bind-mount this container's paths into them.
FROM golang:1.26-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        borgbackup \
        docker.io \
        openssh-client \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest

WORKDIR /src
